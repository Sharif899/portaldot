# PortalRWA Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# ── Portaldot Node ────────────────────────────────────────────
# WebSocket endpoint of the Portaldot testnet node
NEXT_PUBLIC_PORTALDOT_WS=wss://testnet.portaldot.world

# ── Contract Addresses (auto-filled by deploy.js) ────────────
# Run: cd contracts && node deploy.js
# Then copy the printed addresses here
NEXT_PUBLIC_ZKP_VERIFIER=5REPLACE_WITH_DEPLOYED_ZKP_ADDRESS
NEXT_PUBLIC_MARKETPLACE=5REPLACE_WITH_DEPLOYED_MARKETPLACE_ADDRESS

# ── Pinata IPFS ───────────────────────────────────────────────
# Get free API keys at: https://app.pinata.cloud/keys
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET=your_pinata_secret_here

# ── Optional: Analytics ───────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=
